<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.winshell" path="/org/gnome/shell/extensions/winshell/">
    <key name="panel-height" type="i"><default>54</default><range min="40" max="88"/><summary>Altura da barra</summary></key>
    <key name="center-icons" type="b"><default>true</default><summary>Centralizar aplicativos</summary></key>
    <key name="show-clock" type="b"><default>true</default><summary>Exibir relógio</summary></key>
    <key name="show-search" type="b"><default>true</default><summary>Exibir pesquisa</summary></key>
    <key name="show-notifications" type="b"><default>true</default><summary>Botão de notificações</summary></key>
    <key name="show-quick-settings" type="b"><default>true</default><summary>Botão de configurações rápidas</summary></key>
    <key name="show-activities-panel" type="b"><default>true</default><summary>Manter o painel GNOME superior</summary></key>
    <key name="multi-monitor" type="b"><default>false</default><summary>Barra em todos os monitores</summary></key>
    <key name="snap-layouts" type="b"><default>true</default><summary>Habilitar Snap Layouts gráficos</summary></key>
    <key name="window-previews" type="b"><default>true</default><summary>Pré-visualizações de janelas</summary></key>
    <key name="taskbar-conflict-handling" type="s">
      <choices>
        <choice value="automatic"/>
        <choice value="warn-only"/>
        <choice value="disabled"/>
      </choices>
      <default>'automatic'</default>
      <summary>Tratamento de conflitos da barra de tarefas</summary>
      <description>Desativa com segurança, apenas avisa ou ignora barras concorrentes conhecidas.</description>
    </key>
    <key name="managed-taskbar-extensions" type="as">
      <default>[]</default>
      <summary>Extensões temporariamente gerenciadas pelo WinShell</summary>
      <description>Estado interno usado para restaurar extensões concorrentes que o WinShell desativou.</description>
    </key>
    <key name="pinned-apps" type="as"><default>['org.gnome.Nautilus.desktop', 'firefox.desktop', 'org.gnome.Terminal.desktop']</default><summary>IDs dos aplicativos fixados</summary></key>
  </schema>
</schemalist>
