<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.winshell" path="/org/gnome/shell/extensions/winshell/">
    <key name="panel-height" type="i"><default>54</default><range min="40" max="88"/><summary>Altura da barra</summary></key>
    <key name="center-icons" type="b"><default>true</default><summary>Centralizar aplicativos</summary></key>
    <key name="show-clock" type="b"><default>true</default><summary>Exibir relógio</summary></key>
    <key name="show-search" type="b"><default>true</default><summary>Exibir pesquisa</summary></key>
    <key name="show-notifications" type="b"><default>true</default><summary>Botão de notificações</summary></key>
    <key name="show-quick-settings" type="b"><default>true</default><summary>Botão de configurações rápidas</summary></key>
    <key name="show-activities-panel" type="b"><default>true</default><summary>Manter o painel GNOME superior</summary></key>
    <key name="multi-monitor" type="b"><default>false</default><summary>Barra em todos os monitores</summary></key>
    <key name="snap-layouts" type="b"><default>true</default><summary>Habilitar Snap Layouts gráficos</summary></key>
    <key name="window-previews" type="b"><default>true</default><summary>Pré-visualizações de janelas</summary></key>
    <key name="taskbar-conflict-handling" type="s">
      <choices>
        <choice value="automatic"/>
        <choice value="warn-only"/>
        <choice value="disabled"/>
      </choices>
      <default>'automatic'</default>
      <summary>Tratamento de conflitos da barra de tarefas</summary>
      <description>Desativa com segurança, apenas avisa ou ignora barras concorrentes conhecidas.</description>
    </key>
    <key name="managed-taskbar-extensions" type="as">
      <default>[]</default>
      <summary>Extensões temporariamente gerenciadas pelo WinShell</summary>
      <description>Estado interno usado para restaurar extensões concorrentes que o WinShell desativou.</description>
    </key>
    <key name="pinned-apps" type="as"><default>['org.gnome.Nautilus.desktop', 'firefox.desktop', 'org.gnome.Terminal.desktop']</default><summary>IDs dos aplicativos fixados</summary></key>
    <key name="appearance-mode" type="s">
      <choices><choice value="follow-system"/><choice value="light"/><choice value="dark"/></choices>
      <default>'follow-system'</default>
      <summary>Variante visual do WinShell</summary>
    </key>
    <key name="visual-preset" type="s">
      <choices><choice value="balanced"/><choice value="subtle"/><choice value="high-contrast"/></choices>
      <default>'balanced'</default>
      <summary>Preset visual</summary>
    </key>
    <key name="icon-theme" type="s"><default>'WinShell'</default><summary>Tema de ícones escolhido</summary></key>
    <key name="wallpaper-selection" type="s">
      <choices><choice value="synchronized"/><choice value="light"/><choice value="dark"/><choice value="custom"/></choices>
      <default>'synchronized'</default>
      <summary>Seleção de papel de parede</summary>
    </key>
    <key name="custom-wallpaper-uri" type="s"><default>''</default><summary>Papel de parede personalizado</summary></key>
    <key name="background-style" type="s">
      <choices><choice value="zoom"/><choice value="scaled"/><choice value="centered"/><choice value="spanned"/><choice value="wallpaper"/></choices>
      <default>'zoom'</default>
      <summary>Posicionamento do papel de parede</summary>
    </key>
    <key name="sync-system-appearance" type="b"><default>false</default><summary>Sincronizar aparência do GNOME explicitamente</summary></key>
    <key name="desktop-icons-enabled" type="b"><default>false</default><summary>Integrar com um provedor de ícones da área de trabalho</summary></key>
    <key name="desktop-show-home" type="b"><default>true</default><summary>Mostrar pasta pessoal na área de trabalho</summary></key>
    <key name="desktop-show-trash" type="b"><default>true</default><summary>Mostrar lixeira na área de trabalho</summary></key>
    <key name="desktop-show-volumes" type="b"><default>true</default><summary>Mostrar volumes montados na área de trabalho</summary></key>
    <key name="nautilus-integration-enabled" type="b"><default>false</default><summary>Habilitar integração opcional do Nautilus</summary></key>
  </schema>
</schemalist>
